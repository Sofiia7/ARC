# Secrets & Credentials
.env
.env.*
!.env.example
!**/.env.example
*.key
*.pem
*.json
!package.json
!package-lock.json
!**/package-lock.json
!tsconfig.json
!openclaw.json
!**/slither.config.json
!**/.eslintrc.json
!**/vercel.json
!mcp-server/server.json
# .mcpb manifest - declares tool schemas and the NAMES of user-supplied
# credentials, never their values (env entries are ${user_config.*}
# placeholders). Needed in-tree to rebuild a .mcpb reproducibly.
!mcp-server/manifest.json
# Same file with per-tool inputSchema, for Smithery - the official mcpb schema
# rejects that key, so the two variants cannot be one file.
!mcp-server/manifest.smithery.json
# The BaseBounty distribution of the same server: its own catalog identity
# (registry entry, .mcpb manifests), the implementation stays in mcp-server/.
!basebounty-mcp/server.json
!basebounty-mcp/manifest.json
!basebounty-mcp/manifest.smithery.json
!glama.json
# Claude Code / Cursor plugin manifests. Public metadata only: package names,
# network choice and the skill path. No credentials - the MCP servers they
# declare start read-only and take a key only from the user own environment.
!.claude-plugin/plugin.json
!.claude-plugin/marketplace.json
!.cursor-plugin/plugin.json
secrets.json

