!mcp-server/server.json
# .mcpb manifest — declares tool schemas and the NAMES of user-supplied
# credentials, never their values (env entries are ${user_config.*}
# placeholders). Needed in-tree to rebuild a .mcpb reproducibly.
!mcp-server/manifest.json
# Same file with per-tool inputSchema, for Smithery — the official mcpb schema
# rejects that key, so the two variants cannot be one file.
!mcp-server/manifest.smithery.json
!glama.json
secrets.json

