{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "nadbounty": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "nadbounty-mcp"
      ],
      "env": {
        "NAD_NETWORK": "monad-mainnet"
      }
    },
    "basebounty": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "basebounty-mcp"
      ],
      "env": {
        "ARC_NETWORK": "base-mainnet"
      }
    },
    "arcbounty": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "arcbounty-mcp"
      ],
      "env": {
        "ARC_NETWORK": "arc-mainnet"
      }
    }
  }
}
