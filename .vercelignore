# Never upload as deploy source - huge local-only files that broke the
# 100MB/file Vercel upload limit (2026-07-25). These are already excluded
# from git via .gitignore, but the repo-root monorepo link (.vercel/repo.json,
# directory: "frontend") uploads the whole tree regardless of git tracking,
# so they need an explicit .vercelignore too.
Видео/
*.mp4

# Build/dependency artifacts - never needed as deploy source, Vercel installs
# and builds fresh.
node_modules/
.next/
dist/
build/

# Contracts build output - irrelevant to the frontend deploy.
contracts/out/
contracts/cache/

# Secrets. The CLI's built-in ignores cover only .env.local and .env.*.local,
# so until 2026-09-16 a deploy from this repo root could upload the root .env,
# private keys included, into the deployment source. Nothing here reads them
# at build time: Next.js loads env files from frontend/, and production values
# live in the Vercel project settings.
.env
.env.*
**/.env
**/.env.*

# Local-only material with no place in a frontend deploy.
*.pptx
*.pdf
docs/security/
contracts/lib/
contracts/broadcast/
