# ─── Network selection (BUILD time) ────────────────────────────────────────────
# One build = one network. Production runs as two separate Vercel projects,
# one per network, each with NEXT_PUBLIC_ARC_NETWORK set accordingly. See
# lib/networks.ts and the "Networks" section of README.md.
#   arc-testnet (default) — live today, no other vars required below.
#   arc-mainnet            — requires the whole NEXT_PUBLIC_ARC_MAINNET_* block
#                             further down; building without them throws a
#                             descriptive error listing exactly what's missing.
NEXT_PUBLIC_ARC_NETWORK=arc-testnet

# Arc Testnet RPC endpoint override (optional — defaults to the public RPC below)
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network

# Deployed BountyAdapter address override. Works on either network — takes
# priority over the network's own default (arc-testnet has none baked in, so
# this is effectively mandatory there; arc-mainnet's default comes from
# NEXT_PUBLIC_ARC_MAINNET_BOUNTY_ADAPTER below).
NEXT_PUBLIC_BOUNTY_ADAPTER_ADDRESS=0x538CD48789667168bfb36f838Af8476237F9409F

# WalletConnect Cloud project id — free at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=

# ─── Arc MAINNET (launches 2026-09-16) ─────────────────────────────────────────
# Circle has NOT published mainnet parameters yet — do not guess them. Once
# they appear at https://docs.arc.io/arc/references/contract-addresses, fill
# these in, set NEXT_PUBLIC_ARC_NETWORK=arc-mainnet above (in the mainnet
# Vercel project's env, not this one), and redeploy. Until ALL of these are
# set, building with NEXT_PUBLIC_ARC_NETWORK=arc-mainnet throws a descriptive
# error listing exactly what's missing — it never falls back to guessed values.
# NEXT_PUBLIC_ARC_MAINNET_CHAIN_ID=
# NEXT_PUBLIC_ARC_MAINNET_RPC_URL=
# NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL=
# NEXT_PUBLIC_ARC_MAINNET_EXPLORER_API_URL=
# NEXT_PUBLIC_ARC_MAINNET_AGENTIC_COMMERCE=
# NEXT_PUBLIC_ARC_MAINNET_IDENTITY_REGISTRY=
# NEXT_PUBLIC_ARC_MAINNET_REPUTATION_REGISTRY=
# NEXT_PUBLIC_ARC_MAINNET_USDC=
# NEXT_PUBLIC_ARC_MAINNET_BOUNTY_ADAPTER=
# NEXT_PUBLIC_ARC_MAINNET_ADAPTER_DEPLOY_BLOCK=
# NEXT_PUBLIC_ARC_MAINNET_BLOCKS_PER_DAY=
# NEXT_PUBLIC_ARC_MAINNET_MAX_LOOKBACK_BLOCKS=

# Pinata JWT with file-upload permission — used by /api/ipfs/pin* routes (server-side only)
PINATA_JWT=

# ─── Optional: distributed rate-limit (Upstash Redis REST) ────────────────────
# If set, /api/ipfs/pin* limit requests cross-instance. If unset, an in-memory
# per-instance limiter is used. Create a free DB at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Optional: keeper cron (/api/cron/keeper) ─────────────────────────────────
# Drives permissionless liveness: expireBounty + autoApprove. Route is inert
# (503) until KEEPER_PRIVATE_KEY is set. Use a low-value wallet (gas only).
KEEPER_PRIVATE_KEY=
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`. Set the same value here.
CRON_SECRET=

