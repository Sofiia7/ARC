# ─── Network selection (BUILD time) ────────────────────────────────────────────
# One build = one network. Production runs as two separate Vercel projects,
# one per network, each with NEXT_PUBLIC_ARC_NETWORK set accordingly. See
# lib/networks.ts and the "Networks" section of README.md.
#   arc-testnet (default) - live today, no other vars required below.
#   base-sepolia           - the Base build; see the BASE block below.
#   arc-mainnet            - live since 2026-09-16 (arcbounty.app). Every address
#                             is built in (lib/networks.ts); nothing else is
#                             needed. See the Arc MAINNET block further down.
#   monad-mainnet          - live (nadbounty.app, NadBounty V4.8.1). Every address
#                             is built in; nothing else is needed.
#   monad-testnet          - the NadBounty rehearsal build (V4.8); see the last
#                             block of this file.
#
# The build's BRAND follows from this: arc-* builds ship as ArcBounty
# (arcbounty.app), base-* builds as BaseBounty (basebounty.app). There is no
# separate brand variable - see `brand` in lib/networks.ts.
NEXT_PUBLIC_ARC_NETWORK=arc-testnet

# Arc Testnet RPC endpoint override (optional - defaults to the public RPC
# below). Applies ONLY to arc-testnet: each network reads its own override
# (base-sepolia uses NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL). Leaving this set in a
# Base project is harmless, but do not expect it to affect the Base build.
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.network

# Deployed BountyAdapter address override. Works on ANY network - takes
# priority over that network's own default, so it MUST be either unset or the
# right address for the network being built. Pointing a Base build at the Arc
# adapter is the easy mistake: the build succeeds and the board silently
# renders empty, because that address has no code on Base.
#   arc-testnet  - no baked-in default, so this is effectively mandatory.
#   base-sepolia - defaults to the Base adapter; safe to leave UNSET.
NEXT_PUBLIC_BOUNTY_ADAPTER_ADDRESS=0xeDf2c738915b042da97788b2b5499D4655FB1f20

# WalletConnect Cloud project id - free at https://cloud.walletconnect.com
NEXT_PUBLIC_WC_PROJECT_ID=

# ─── BASE build (BaseBounty) ──────────────────────────────────────────────────
# The complete set for the Base Vercel project. Everything not listed here is
# shared with the Arc project (PINATA_JWT, UPSTASH_*, NEXT_PUBLIC_WC_PROJECT_ID).
#
#   NEXT_PUBLIC_ARC_NETWORK=base-sepolia
#   NEXT_PUBLIC_SITE_URL=https://basebounty.app
#   NEXT_PUBLIC_BOUNTY_ADAPTER_ADDRESS=          <- leave UNSET (baked-in default)
#   NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=            <- optional, see below
#
# Base Sepolia RPC override. The public sepolia.base.org node is rate-limited
# the same way Arc's is, so a dedicated endpoint is worth having before the
# board gets real traffic. Contract addresses are NOT env-driven on Base: they
# are known and verified, and live in lib/networks.ts.
# NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Canonical site URL - drives metadataBase and the OG card's URL. Defaults to
# the active brand's domain, so it only needs setting for preview deployments
# or if a build serves a different hostname.
# NEXT_PUBLIC_SITE_URL=

# ─── Arc MAINNET (live since 2026-09-16) ───────────────────────────────────────
# arc-mainnet has every address built in (lib/networks.ts, values in
# contracts/DEPLOYMENTS.md), so NEXT_PUBLIC_ARC_NETWORK=arc-mainnet alone is
# enough. The only variable it still reads is this RPC override, which must
# serve 10,000-block eth_getLogs ranges (set it in the mainnet Vercel project).
# NEXT_PUBLIC_ARC_MAINNET_RPC_URL=https://rpc.blockdaemon.mainnet.arc.io

# Pinata JWT with file-upload permission - used by /api/ipfs/pin* routes (server-side only)
PINATA_JWT=

# ─── Optional: distributed rate-limit (Upstash Redis REST) ────────────────────
# If set, /api/ipfs/pin* limit requests cross-instance. If unset, an in-memory
# per-instance limiter is used. Create a free DB at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Optional: keeper cron (/api/cron/keeper) ─────────────────────────────────
# Drives permissionless liveness: expireBounty + autoApprove. Route is inert
# (503) until KEEPER_PRIVATE_KEY is set. Use a low-value wallet (gas only).
KEEPER_PRIVATE_KEY=
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`. Set the same value here.
CRON_SECRET=


# NadBounty on Monad mainnet (nadbounty.app): this is the whole configuration.
# Every address is built in and an adapter override is ignored on mainnets.
# NEXT_PUBLIC_ARC_NETWORK=monad-mainnet
# Optional RPC override: NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz
#
# NadBounty testnet (V4.8 rehearsal) uses a separate override; Arc/Base addresses
# are ignored. The adapter below is also the built-in default, so the override
# is optional.
# NEXT_PUBLIC_ARC_NETWORK=monad-testnet
# NEXT_PUBLIC_NAD_BOUNTY_ADAPTER_ADDRESS=0xf88B980B3AB1CD5A2Befd9c0B88B70196f215020
# NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
