# ─── Network ─────────────────────────────────────────────────────────────────
# Which network THIS deployed instance serves. One instance = one network -
# there is no per-request switch, and the product name follows the network
# (ArcBounty on Arc, BaseBounty on Base), so serving both means two
# deployments. "arc-testnet" | "base-mainnet" | "base-sepolia" | "arc-mainnet".
NETWORK=arc-testnet

# ── If NETWORK=base-mainnet (BaseBounty, live since 2026-08-14) ──
# The complete set for the Base mainnet instance:
#
#   NETWORK=base-mainnet
#   SELLER_ADDRESS=0x...            <- paid mode is fine here, see below
#   BASE_MAINNET_RPC_URL=           <- optional, recommended
#
# Nothing else. Every contract address, including the BountyAdapter, resolves
# from the SDK's verified network map; BOUNTY_ADAPTER_ADDRESS below is a
# testnet-only override and is deliberately ignored on mainnet chains, so a
# leftover testnet address cannot end up pointed at real funds.
#
# Paid mode IS supported here: docs/INTEGRATION_NOTES.md confirms x402
# settlement through Circle Gateway on Base mainnet. The public
# mainnet.base.org endpoint is rate limited and load balanced, so a dedicated
# RPC is worth setting for anything with traffic.
# BASE_MAINNET_RPC_URL=

# ── If NETWORK=base-sepolia (BaseBounty staging) ──
#
#   NETWORK=base-sepolia
#   SELLER_ADDRESS=                <- leave UNSET, see the caveat below
#   BASE_SEPOLIA_RPC_URL=          <- optional override of sepolia.base.org
#
# CAVEAT - do not enable paid mode here. docs/INTEGRATION_NOTES.md confirms
# x402 settlement through Circle Gateway on Base MAINNET and Arc Testnet; Base
# *Sepolia* settlement is not confirmed (the "Base Sepolia ✅" in those notes
# is about Agent Wallets, a different product). Leaving SELLER_ADDRESS unset
# runs the instance in free mode, which is the intended state for staging.
# BASE_SEPOLIA_RPC_URL=

# ── If NETWORK=arc-mainnet (ArcBounty, live since 2026-09-16) ──
#
#   NETWORK=arc-mainnet
#   ARC_MAINNET_RPC_URL=           <- optional override of the Blockdaemon RPC
#
# Nothing else: chain id 5042, every contract address and the BountyAdapter
# ship in arcbounty-agent-sdk 0.8.0's network map (contracts/DEPLOYMENTS.md).
#
# CAVEAT: check that Circle Gateway (the x402 facilitator) lists Arc mainnet at
# https://developers.circle.com/gateway/references/supported-blockchains
# before running a paid (SELLER_ADDRESS set) instance on it.
# ARC_MAINNET_RPC_URL=

# ─── Adapter override (testnets only, optional) ──────────────────────────────
# Every network carries its canonical adapter (contracts/DEPLOYMENTS.md), so
# this can stay unset. It is read on testnets only: on a mainnet chain the
# value is ignored rather than trusted, which is what keeps a stale testnet
# address away from real money.
BOUNTY_ADAPTER_ADDRESS=0xeDf2c738915b042da97788b2b5499D4655FB1f20

# ─── Payments (x402) ─────────────────────────────────────────────────────────
# Wallet that receives x402 USDC payments. UNSET → free mode (no 402s, dev only).
SELLER_ADDRESS=
# Circle Gateway facilitator. Default is per-network: testnet
# https://gateway-api-testnet.circle.com, mainnet https://gateway-api.circle.com
# - set this only to override that default.
FACILITATOR_URL=

# ─── Optional ────────────────────────────────────────────────────────────────
PORT=8402
# Arc Testnet RPC override, read on arc-testnet only. Each network has its own
# variable (ARC_MAINNET_RPC_URL, BASE_MAINNET_RPC_URL, BASE_SEPOLIA_RPC_URL);
# unset, the network's public RPC is used. The public Arc Testnet RPC is
# rate-limited, so a dedicated endpoint is worth it in production.
ARC_RPC_URL=
CACHE_TTL_MS=20000
